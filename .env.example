# Which implementation to use for each module
SOURCE=bitbucket-cloud
# claude | heuristic (free, no LLM)
ANALYZER=claude
DB_PATH=data/reviewer.db

# Bitbucket Cloud
BITBUCKET_WORKSPACE=
BITBUCKET_API_TOKEN=
# Optional: if set, uses Basic auth (email + token) instead of Bearer
BITBUCKET_EMAIL=
# Optional: comma-separated repo slugs to check. Empty = every repo in the workspace
BITBUCKET_REPOS=

# Claude: set ANTHROPIC_API_KEY, or leave it empty if you ran `ant auth login`
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# API server (pnpm server / docker)
PORT=3000
# Automatic sync, cron format. Empty = only manual. Example: 9:00 and 14:00 on weekdays
SYNC_CRON=0 9,14 * * 1-5
SYNC_TIMEZONE=America/Sao_Paulo
# Optional: max PRs each scheduled run analyzes (caps cost). Empty = no limit
SYNC_LIMIT=
